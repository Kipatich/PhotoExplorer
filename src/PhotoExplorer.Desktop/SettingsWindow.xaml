<Window x:Class="PhotoExplorer.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройки · Фото проводник" Width="520" Height="630" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource Canvas}"><StackPanel Margin="30"><TextBlock Text="Настройки" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,24"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Оформление" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Grid.Column="1" SelectionChanged="OnThemeChanged"><ComboBoxItem Content="Тёмное"/><ComboBoxItem Content="Светлое"/></ComboBox></Grid>
    <Grid Margin="0,22,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Слайд-шоу, секунд" VerticalAlignment="Center"/><Slider x:Name="IntervalSlider" Grid.Column="1" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnIntervalChanged"/><TextBlock x:Name="IntervalLabel" Grid.Column="1" HorizontalAlignment="Right" Margin="0,25,0,0" Foreground="{DynamicResource Muted}"/></Grid>
    <Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Глубина поиска" VerticalAlignment="Center"/><TextBox x:Name="DepthBox" Grid.Column="1" TextChanged="OnDepthChanged" LostKeyboardFocus="OnDepthLostFocus" AutomationProperties.Name="Глубина поиска в подпапках"/></Grid>
    <TextBlock x:Name="DepthHint" Text="0 — без ограничений; 2 — два уровня подпапок.&#10;Применяется, когда включён поиск в подпапках." Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,22"/><TextBlock Text="Кеш миниатюр" FontWeight="SemiBold"/><TextBlock x:Name="CacheLabel" Foreground="{DynamicResource Muted}" Margin="0,8,0,12" TextWrapping="Wrap"/><Button x:Name="ClearButton" Content="Очистить кеш" Click="OnClearCache" HorizontalAlignment="Left" Background="{DynamicResource Raised}"/>
    <TextBlock Text="Настройки сохраняются автоматически." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,22,0,18"/><Button Content="Готово" IsCancel="True" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"/>
  </StackPanel></Border>
</Window>
