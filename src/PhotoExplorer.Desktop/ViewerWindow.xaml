<Window x:Class="PhotoExplorer.Desktop.ViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Просмотр изображения" Background="#0C0E12" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" PreviewKeyDown="OnKeyDown" PreviewMouseWheel="OnMouseWheel" Closed="OnClosed">
  <Grid Background="#0C0E12">
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24" Margin="0,66,0,64" PanningMode="Both" PreviewMouseLeftButtonDown="OnPanStart" PreviewMouseMove="OnPanMove" PreviewMouseLeftButtonUp="OnPanEnd">
      <Grid x:Name="ImageHost"><Image x:Name="Photo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MouseDown="OnImageClick"/></Grid>
    </ScrollViewer>
    <TextBlock x:Name="ErrorLabel" Foreground="#ABB4C1" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" MaxWidth="600"/>
    <Border VerticalAlignment="Top" Background="#171B22" Height="64"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="FileLabel" Foreground="#EFF2F6" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="CounterLabel" Foreground="#919BAA" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Закрыть" Click="OnClose" Foreground="#EFF2F6" VerticalAlignment="Center"/></Grid></Border>
    <Border VerticalAlignment="Bottom" Background="#171B22" Height="64"><Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="Колесо — масштаб · перетаскивание — панорама" Foreground="#919BAA" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="←" Click="OnPrevious" Foreground="#EFF2F6" ToolTip="Предыдущее · ←"/><Button x:Name="PlayButton" Content="▶  Слайд-шоу" Click="OnPlay" Foreground="#EFF2F6" Margin="10,0" ToolTip="Пробел"/><Button Content="→" Click="OnNext" Foreground="#EFF2F6" ToolTip="Следующее · →"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="−" Click="OnZoomOut" Foreground="#EFF2F6"/><TextBlock x:Name="ZoomLabel" Text="По размеру экрана" Width="112" TextAlignment="Center" VerticalAlignment="Center" Foreground="#919BAA" FontSize="11"/><Button Content="+" Click="OnZoomIn" Foreground="#EFF2F6"/><Button Content="1:1" Click="OnActualSize" Foreground="#EFF2F6"/><Button Content="По размеру экрана" Click="OnFit" Foreground="#EFF2F6"/></StackPanel>
    </Grid></Border>
  </Grid>
</Window>
