<Window x:Class="PhotoExplorer.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PhotoExplorer.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  WindowStyle="None" Title="Фото проводник" Width="1440" Height="920" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown" AllowDrop="True" Drop="OnDrop" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="68" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="LocationTemplate"><Button Click="OnLocation" HorizontalContentAlignment="Left" Padding="14,10" Margin="6,1" ToolTip="{Binding Path}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" Width="28"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="158"/></StackPanel></Button></DataTemplate>
    <DataTemplate x:Key="PhotoTemplate">
      <Button Click="OnSelectPhoto" MouseDoubleClick="OnPhotoDoubleClick" Loaded="OnTileLoaded" Unloaded="OnTileUnloaded" Padding="0" Margin="0,0,14,18" HorizontalContentAlignment="Stretch" ToolTip="{Binding File.FullPath}" AutomationProperties.Name="{Binding Name}">
        <Button.Template><ControlTemplate TargetType="Button">
          <Border x:Name="Tile" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="7" Padding="5">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{DynamicResource Raised}" CornerRadius="4" Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Window}}" ClipToBounds="True">
                <Grid><TextBlock Text="{Binding Placeholder}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/><Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
              </Border>
              <StackPanel Grid.Row="1" Margin="3,10,3,4"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Selection}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="32" Height="32" Background="{DynamicResource Selection}" CornerRadius="8" Margin="0,0,12,0"><TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Фото проводник" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Просмотр и навигация по изображениям" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="Открыть папку" Style="{StaticResource PrimaryButton}" Click="OnOpenFolder" Margin="0,0,18,0" ToolTip="Ctrl+O"/><Button Content="&#xE706;" Style="{StaticResource IconButton}" Command="{Binding ThemeCommand}" ToolTip="Сменить тему" AutomationProperties.Name="Сменить тему"/><Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="OnSettings" ToolTip="Настройки" AutomationProperties.Name="Настройки"/><Button Content="&#xE897;" Style="{StaticResource IconButton}" Click="OnHelp" ToolTip="Справка · F1" AutomationProperties.Name="Справка"/><Border Width="1" Height="24" Background="{DynamicResource Line}" Margin="14,0,8,0"/><Button Content="&#xE921;" Style="{StaticResource IconButton}" Click="OnMinimize" ToolTip="Свернуть" AutomationProperties.Name="Свернуть"/><Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource IconButton}" Click="OnMaximize" ToolTip="Развернуть / восстановить" AutomationProperties.Name="Развернуть или восстановить"/><Button Content="&#xE8BB;" Style="{StaticResource IconButton}" Click="OnCloseWindow" ToolTip="Закрыть" AutomationProperties.Name="Закрыть"/></StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="12,9,20,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Button Content="&#xE72B;" Style="{StaticResource IconButton}" Command="{Binding BackCommand}" ToolTip="Назад · Alt+←" AutomationProperties.Name="Назад"/><Button Content="&#xE72A;" Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" ToolTip="Вперёд · Alt+→" AutomationProperties.Name="Вперёд"/><Button Content="&#xE74A;" Style="{StaticResource IconButton}" Command="{Binding UpCommand}" ToolTip="На уровень выше · Alt+↑" AutomationProperties.Name="На уровень выше"/></StackPanel>
        <TextBox x:Name="AddressBox" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnAddressKey" ToolTip="Путь к папке · Ctrl+L" AutomationProperties.Name="Путь к папке"/>
        <Grid Grid.Column="2" Margin="14,0,0,0"><TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,28,7" AutomationProperties.Name="Поиск по имени"/><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/><TextBlock Text="Поиск по имени   Ctrl+F" Foreground="{DynamicResource Muted}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="×" HorizontalAlignment="Right" Padding="7,0" Command="{Binding ClearSearchCommand}" Visibility="{Binding HasQuery, Converter={StaticResource BoolVisibility}}" ToolTip="Сбросить поиск"/></Grid>
      </Grid>
    </Border>
    <Grid x:Name="PaneGrid" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="218" MinWidth="170" MaxWidth="480"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="InspectorColumn" Width="278" MinWidth="220" MaxWidth="560"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,12,12,16"><Button Click="OnDemo" HorizontalContentAlignment="Left" Padding="10,9"><StackPanel><TextBlock Text="Открыть демоколлекцию" FontSize="11"/><TextBlock Text="12 пейзажных иллюстраций" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></Button></StackPanel>
        <ScrollViewer x:Name="NavigationScroll" PreviewMouseWheel="OnNavigationWheel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <TextBlock Text="БЫСТРЫЙ ДОСТУП" Style="{StaticResource SectionLabel}"/><ItemsControl ItemsSource="{Binding Locations}" ItemTemplate="{StaticResource LocationTemplate}"/>
          <TextBlock Text="ИЗБРАННЫЕ ПАПКИ" Style="{StaticResource SectionLabel}"/><ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource LocationTemplate}"/>
          <TextBlock Text="Добавьте папку кнопкой ☆" Foreground="{DynamicResource Muted}" FontSize="10" Margin="20,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Favorites.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock Text="ЭТОТ КОМПЬЮТЕР" Style="{StaticResource SectionLabel}"/>
          <TreeView x:Name="FolderTree" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0" Margin="10,0" SelectedItemChanged="OnFolderSelected" HorizontalContentAlignment="Stretch"><TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><Grid ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></Grid></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView>
        </StackPanel></ScrollViewer>
      </DockPanel></Border>
      <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" DragCompleted="OnSplitterCompleted" ToolTip="Изменить ширину проводника"/><Grid Grid.Column="2" Margin="18,24,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,14,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FolderTitle}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="{Binding FavoriteIcon}" Command="{Binding FavoriteCommand}" ToolTip="{Binding FavoriteLabel}" FontSize="24" Padding="8,1"/><Button Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Обновить · F5" AutomationProperties.Name="Обновить"/></StackPanel></Grid>
        <Grid Grid.Row="1" Margin="0,0,14,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox Content="Искать в подпапках" IsChecked="{Binding Recursive}" VerticalAlignment="Center" FontSize="11"/><ComboBox Grid.Column="1" ItemsSource="{Binding SortChoices}" SelectedIndex="{Binding SortIndex}" Width="170" AutomationProperties.Name="Сортировка"/></Grid>
        <ListBox x:Name="PhotoList" Grid.Row="2" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel" SizeChanged="OnGridSizeChanged" Focusable="False">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PhotoTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="44" HorizontalAlignment="Center"/><TextBlock Text="Здесь пока нет изображений" FontSize="19" Margin="0,20,0,10" HorizontalAlignment="Center"/><TextBlock Text="Выберите другую папку или измените поиск.&#10;Можно перетащить папку прямо в окно." Foreground="{DynamicResource Muted}" TextAlignment="Center" LineHeight="22"/><Button Content="Выбрать папку" Click="OnOpenFolder" Margin="0,20,0,0" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}"/></StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource Canvas}" Opacity=".94" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><ProgressBar Width="170" Height="3" IsIndeterminate="True" Foreground="{DynamicResource Accent}"/><TextBlock Text="Сканируем директории…" Foreground="{DynamicResource Muted}" Margin="0,16,0,0" HorizontalAlignment="Center"/><TextBlock Text="{Binding ScanProgressText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="12,12,12,0" MaxWidth="350"/></StackPanel></Border>
      </Grid>
      <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" DragCompleted="OnSplitterCompleted" ToolTip="Изменить ширину сведений"/><Border Grid.Column="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,25,20,20">
        <TextBlock Text="СВЕДЕНИЯ О ФАЙЛЕ" Foreground="{DynamicResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <Grid Height="190" Background="{DynamicResource Canvas}"><Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MouseDown="OnPreviewClick" Cursor="Hand"/><TextBlock Text="{Binding PreviewError}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"/></Grid>
        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,19,0,7"/><TextBlock Text="{Binding Selected.Caption}" Foreground="{DynamicResource Muted}" FontSize="11"/>
          <Button Content="На весь экран   ↗" Click="OnFullscreen" Style="{StaticResource PrimaryButton}" Margin="0,22,0,24" ToolTip="Enter / F11"/>
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,22"/>
          <TextBlock Text="РАЗРЕШЕНИЕ" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Text="{Binding Dimensions}" Margin="0,7,0,21"/>
          <TextBlock Text="ИЗМЕНЁН" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Text="{Binding Selected.Date}" FontSize="12" Margin="0,7,0,21"/>
          <TextBlock Text="РАСПОЛОЖЕНИЕ" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Text="{Binding Selected.File.FullPath}" TextWrapping="Wrap" FontSize="11" LineHeight="18" Margin="0,7,0,18"/>
          <Button Content="Показать в проводнике" Click="OnReveal" HorizontalContentAlignment="Left" Padding="0,8" Foreground="{DynamicResource Accent}" FontSize="11"/>
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,22,0,18"/><TextBlock Text="Enter — открыть   ·   ← → — выбрать&#10;F1 — все сочетания клавиш" Foreground="{DynamicResource Muted}" FontSize="10" LineHeight="19"/>
        </StackPanel>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding TotalSize}" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="20,0"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Масштаб" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Slider x:Name="SizeSlider" Width="115" Minimum="160" Maximum="320" TickFrequency="40" IsSnapToTickEnabled="True" Value="{Binding ThumbnailSize}" ValueChanged="OnThumbnailSizeChanged" ToolTip="Размер миниатюр" AutomationProperties.Name="Размер миниатюр"/></StackPanel></Grid></Border>
  </Grid>
</Window>
